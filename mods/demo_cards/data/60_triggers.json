      "order": 10,
      "actions": [{ "action": "demo_cards:action:refresh_derived" }]
    }
  },
  {
    "id": "demo_cards:trigger:refresh_after_play",
    "type": "trigger",
    "metadata": { "name": "出牌后重算派生值" },
    "data": {
      "event": "demo_cards:event:card_played",
      "order": 10,
      "actions": [{ "action": "demo_cards:action:refresh_derived" }]
